# n2k-mux-web.service — interface de gestion web (consultation + édition config).
#
# Sépare l'UI de la chaîne de données (n2k-mux.service) : un crash/restart du web
# ne touche pas l'acquisition. Lit les JSON publiés par le daemon dans
# /run/n2k-mux (sources/stats) et édite /etc/n2k-mux/n2k-mux.ini ; « Enregistrer »
# écrit le fichier puis envoie SIGHUP au daemon (rechargement à chaud, sans root
# côté client).
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now n2k-mux-web
#   http://<hôte>:8080/

[Unit]
Description=n2k-mux — interface web de gestion
Documentation=https://github.com/ozolli/n2k-mux
# Ordonnancement seulement (pas de Wants) : l'UI ne doit PAS tirer un service de
# données — sinon, avec Conflicts, elle annule l'autre chaîne. Elle lit
# /run/n2k-mux (sources/stats), gracieux si absents. Marche avec NGX-1 OU socketcan.
After=n2k-mux.service n2k-mux-can.service

[Service]
Type=simple

Environment=CONF=/etc/n2k-mux/n2k-mux.ini
Environment=WEB=/usr/local/bin/n2k-mux-web
Environment=PORT=8080 BIND=0.0.0.0
EnvironmentFile=-/etc/default/n2k-mux

# Lit les JSON du daemon dans /run/n2k-mux ; « Enregistrer » écrit la config puis
# recharge à chaud les deux instances n2k-mux (principale + --ais-json).
#
# AUTHENTIFICATION : poser WEB_AUTH=user:pass dans /etc/default/n2k-mux. Le
# credential est passé par l'ENVIRONNEMENT (N2K_MUX_WEB_AUTH) et non sur la
# ligne de commande, qui est lisible par tout utilisateur local via /proc.
# Avec BIND non local (0.0.0.0) et SANS WEB_AUTH, le serveur REFUSE de démarrer
# et le dit dans le journal : l'interface écrit la config et déclenche le reload,
# elle ne doit pas être ouverte au réseau sans mot de passe. Pour assumer le
# risque malgré tout, ajouter --allow-anonymous à la ligne ci-dessous.
#
# SIMULATEUR (onglet Simulateur) : --sim-control désigne le fichier de pilotage,
# partagé avec n2k-mux-sim.service. Par défaut la bascule « Simulateur actif »
# rend seulement le simulateur MUET ou parlant. Pour qu'elle démarre et arrête
# la chaîne simulée, définir SIM_START et SIM_STOP dans /etc/default/n2k-mux —
# SIM_STOP doit remettre TA chaîne réelle, que l'unité simulée a arrêtée
# (Conflicts), sinon le bord reste sans données. Exemples dans n2k-mux.env.example.
ExecStart=/bin/sh -c 'N2K_MUX_WEB_AUTH="${WEB_AUTH:-}" exec "$WEB" "$CONF" --sources /run/n2k-mux/sources.json --stats /run/n2k-mux/stats.json --busmap /run/n2k-mux/busmap.json --port "$PORT" --bind "$BIND" --reload-cmd "pkill -HUP -x n2k-mux" --sim-control "${SIMCTL:-/etc/n2k-mux/sim.ctl}" --sim-state "${SIMSTATE:-/run/n2k-mux/sim.state}" ${SIM_START:+--sim-start "$SIM_START"} ${SIM_STOP:+--sim-stop "$SIM_STOP"}'

Restart=always
RestartSec=3

# Durcissement : /etc reste inscriptible (ProtectSystem=true, PAS full) pour que
# « Enregistrer » puisse écrire /etc/n2k-mux/n2k-mux.ini.
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=true

[Install]
WantedBy=multi-user.target
