# n2k-mux.service — chaîne de production NMEA 2000 → 0183 (systemd)
#
# Installe-le dans /etc/systemd/system/ (ou via `make install`), puis :
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now n2k-mux
#   journalctl -u n2k-mux -f
#
# Réglages (port série, baud, chemins, binaires) : /etc/default/n2k-mux
# (voir n2k-mux.env.example). Les binaires canboat (actisense-serial, analyzer,
# n2kd), n2k-mux et kplex doivent être installés (PATH ou chemins absolus ci-dessous).

[Unit]
Description=n2k-mux — multiplexeur NMEA 2000 vers NMEA 0183
Documentation=https://github.com/ozolli/n2k-mux
After=local-fs.target
# kplex est intégré dans le pipeline (dernier maillon) : l'ancien service kplex
# autonome ne doit pas tourner en parallèle (conflit port série + port 10110).
Conflicts=kplex.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

# Valeurs par défaut, surchargées par /etc/default/n2k-mux s'il existe.
Environment=DEVICE=/dev/ttyNGX1 BAUD=230400
Environment=CONF=/etc/n2k-mux/n2k-mux.ini KPLEX_CONF=/etc/kplex.conf
Environment=ACTISENSE=/usr/local/bin/actisense-serial
Environment=ANALYZER=/usr/local/bin/analyzer
Environment=N2KD=/usr/local/bin/n2kd
Environment=N2KMUX=/usr/local/bin/n2k-mux
Environment=KPLEX=/usr/bin/kplex
EnvironmentFile=-/etc/default/n2k-mux

# /run/n2k-mux (FIFO d'émission + sources.json), créé/nettoyé par systemd.
RuntimeDirectory=n2k-mux
RuntimeDirectoryMode=0755

# FIFO relié au stdin de l'actisense bidirectionnel (émission des ISO Request).
ExecStartPre=/bin/sh -c 'mkfifo -m 0600 /run/n2k-mux/tx.fifo 2>/dev/null || true'

# Chaîne complète : acquisition → arbitrage → AIS (n2kd) → kplex.
#   - analyzer en -json -nv (requis par n2kd ; n2k-mux le gère aussi)
#   - branche AIS : n2k-mux --ais-json (dédup MMSI) → n2kd (encode le VDM, TCP 2599)
#   - branche instruments : n2k-mux (arbitrage) → kplex
# kplex.conf doit lire stdin (entrée file filename=-) ET se connecter en client
# tcp à 127.0.0.1:2599 pour récupérer l'AIS (!AIVDM), puis distribuer.
ExecStart=/bin/bash -c '\
    $ACTISENSE -s $BAUD $DEVICE < /run/n2k-mux/tx.fifo | \
    $ANALYZER -json -nv | \
    tee >($N2KMUX --ais-json $CONF | $N2KD) | \
    $N2KMUX $CONF --tx /run/n2k-mux/tx.fifo --sources /run/n2k-mux/sources.json | \
    $KPLEX -f $KPLEX_CONF'

Restart=always
RestartSec=3

# Accès au port série.
SupplementaryGroups=dialout

# Durcissement raisonnable (n'empêche pas l'exécution depuis /home si besoin).
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
