# kplex.conf — kplex intégré comme dernier maillon du pipeline n2k-mux.service.
#
# Contexte : le NGX-1 est passé en mode TRANSFER (N2K brut). kplex ne peut donc
# plus lire /dev/ttyNGX1 directement (c'était le cas en mode Convert, 115200) :
# n2k-mux décode le N2K (actisense-serial + analyzer) et produit le 0183 que
# kplex lit ici sur stdin. kplex n'est plus un service autonome — il est lancé
# par n2k-mux.service (désactiver l'ancien kplex.service).

[global]
# mode=foreground : kplex est lancé DANS le pipeline (pas de daemon/fork).
# (kplex n'accepte PAS de commentaire en fin de ligne, seulement en début.)
mode=foreground

# === Entrées ===
# Instruments NMEA 0183 produits par n2k-mux (stdin du pipeline).
[file]
direction=in
filename=-

# AIS (VDM) encodé par n2kd, déjà dédupliqué par MMSI (n2k-mux --ais-json).
# persist=fromstart : kplex réessaie la connexion au lieu d'abandonner si n2kd
# n'écoute pas encore (course au démarrage) ou redémarre.
[tcp]
direction=in
mode=client
address=127.0.0.1
port=2599
persist=fromstart
retry=5

# === Sorties (inchangées vs l'install d'origine) ===
[tcp]
mode=server
port=10110
direction=out

[udp]
address=255.255.255.255
port=10110
direction=out

# Log AIS filtré sur disque (OPTIONNEL, désactivé par défaut).
# Cas d'usage local (ex. polar_doctor) : journaliser le trafic NON-AIS.
# Les diffusions LAN (tcp/udp 10110) gardent l'AIS de toute façon.
# Pour l'activer : décommenter le bloc ci-dessous. Le répertoire /var/log/kplex
# est créé automatiquement par `LogsDirectory=kplex` dans le unit systemd
# (sinon kplex échoue à créer le fichier et SORT → toute la chaîne tombe).
#[file]
#direction=out
#filename=/var/log/kplex/o3.log
#append=yes
#ofilter=-AIVDM:-AIVDO
