# n2k-mux — réglages du service systemd.
# Copier vers /etc/default/n2k-mux et adapter. Toutes les variables sont
# facultatives (le service a des valeurs par défaut).

# Port série de la passerelle Actisense (NGX-1/NGT-1) et débit.
DEVICE=/dev/ttyNGX1
BAUD=230400

# Fichiers de configuration.
CONF=/etc/n2k-mux/n2k-mux.ini
KPLEX_CONF=/etc/kplex.conf

# Interface web de gestion (service n2k-mux-web).
#PORT=8080                  # port d'écoute du web
#BIND=0.0.0.0               # 0.0.0.0 = LAN ; 127.0.0.1 = local seul
#WEB_AUTH=admin:motdepasse  # active l'auth HTTP Basic (absent = pas d'auth).
                            # HTTP Basic n'est PAS chiffré : à réserver au LAN ou
                            # derrière un tunnel SSH / un terminateur TLS.

# Emplacement des binaires (si non installés dans /usr/local/bin).
# Exemple pour un canboat compilé dans le home :
#ACTISENSE=/home/ozolli/canboat/rel/linux-x86_64/actisense-serial
#ANALYZER=/home/ozolli/canboat/rel/linux-x86_64/analyzer
#N2KD=/home/ozolli/canboat/rel/linux-x86_64/n2kd
#N2KMUX=/usr/local/bin/n2k-mux
#KPLEX=/usr/bin/kplex

# Pour réduire le bruit des ISO Request une fois le parc stable, passer un
# intervalle plus long via la ligne de commande (--tx-interval) dans le unit,
# ou éditer ExecStart.

# === Variante SOCKETCAN (service n2k-mux-can, adaptateur CAN type PEAK) ========
# Utilisée par n2k-mux-can.service à la place de DEVICE/BAUD/ACTISENSE.
#CANIF=can0                 # interface CAN du bus réel (adaptateur)
#VCANIF=vcan0               # CAN virtuel pour le flux arbitré local (qtVlm)
#CAN_BITRATE=250000         # NMEA 2000 = 250 kbit/s
#YDRAW_PORT=2700            # flux N2K arbitré servi en YDRAW/TCP (qtVlm réseau)
#SRC_ADDR=0                 # adresse source des ISO Request émises sur le bus
#CANDUMP=/usr/bin/candump
#CANDUMP2ANALYZER=/home/ozolli/canboat/rel/linux-x86_64/candump2analyzer
#NFILTER=/usr/local/bin/n2k-filter
