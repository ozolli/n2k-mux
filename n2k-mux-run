#!/bin/bash
# n2k-mux-run — lance la chaîne de production NMEA 2000 → 0183 de façon ROBUSTE.
#
# Remplace l'ancien « bash -c '... | tee >(... | n2kd) | ...' » qui :
#   - laissait survivre n2kd (substitution de process) → collision de ports au start ;
#   - continuait en mode dégradé silencieux si un étage mourait (ex. n2kd).
#
# Ici : la branche AIS passe par un FIFO nommé (pas de >(...)) et TOUS les
# composants sont des jobs suivis. `wait -n` rend la main dès qu'UN composant
# meurt → le script sort en erreur → systemd (Restart) relance TOUT proprement,
# et KillMode=control-group tue le cgroup entier (aucun zombie).
#
# Variables fournies par le service (Environment / EnvironmentFile) :
#   DEVICE BAUD CONF KPLEX_CONF ACTISENSE ANALYZER N2KD N2KMUX KPLEX

set -uo pipefail

: "${DEVICE:?}" "${BAUD:?}" "${CONF:?}" "${KPLEX_CONF:?}"
: "${ACTISENSE:?}" "${ANALYZER:?}" "${N2KD:?}" "${N2KMUX:?}" "${KPLEX:?}"

RUN="${RUNTIME_DIRECTORY:-/run/n2k-mux}"   # fourni par systemd (RuntimeDirectory=)
TXFIFO="$RUN/tx.fifo"     # ISO Request → actisense bidirectionnel
AISFIFO="$RUN/ais.fifo"   # copie du flux analyzer → branche AIS
YDFIFO="$RUN/ydraw.fifo"  # copie des trames brutes actisense → branche YDRAW
OUTFIFO="$RUN/out0183.fifo" # 0183 du n2k-mux principal → kplex (PID suivi à part)
mkfifo -m 0600 "$TXFIFO"  2>/dev/null || true
mkfifo -m 0600 "$AISFIFO" "$OUTFIFO" 2>/dev/null || true

# On suit les PID des composants CRITIQUES (cf. surveillance en fin de script).
PIDS=()

# Branche N2K (YDRAW réseau pour qtVlm) — OPTIONNELLE : active seulement si le
# binaire ydraw-bridge est présent. Tape les trames BRUTES actisense (avant
# analyzer) et les sert en YDRAW/TCP. Port hors plage n2kd (2597-2602) : déf. 2700.
# $YDRAW_TEE = étage du pipeline : "tee $YDFIFO" si actif, sinon "cat" (no-op).
YDRAW="${YDRAW:-/usr/local/bin/ydraw-bridge}"
YDRAW_PORT="${YDRAW_PORT:-2700}"
YDRAW_TEE=cat
if [ -x "$YDRAW" ]; then
  mkfifo -m 0600 "$YDFIFO" 2>/dev/null || true
  "$YDRAW" --port "$YDRAW_PORT" < "$YDFIFO" &
  PIDS+=($!)
  YDRAW_TEE="tee --output-error=exit $YDFIFO"
fi

# Branche AIS : flux dupliqué (ais.fifo) → dédup MMSI → n2kd (encode le VDM, TCP 2599).
# On suit n2kd ($! = dernier du pipe) ; la mort du filtre amont (n2k-mux --ais-json)
# est rattrapée via le tee --output-error=exit → n2k-mux principal (voir plus bas).
"$N2KMUX" --ais-json "$CONF" < "$AISFIFO" | "$N2KD" &
PIDS+=($!)

# kplex lit le 0183 du n2k-mux principal via OUTFIFO (au lieu d'un pipe direct) :
# ainsi kplex ET le n2k-mux principal sont des jobs distincts dont on tient le PID.
"$KPLEX" -f "$KPLEX_CONF" < "$OUTFIFO" &
PIDS+=($!)

# Branche principale : acquisition → tee(→ydraw.fifo) → analyzer → tee(→ais.fifo)
#   → arbitrage → OUTFIFO (→ kplex). $YDRAW_TEE est non quoté (split en arguments).
# tee --output-error=exit : par défaut tee SURVIT à une erreur d'écriture sur un
# pipe (il continue sur son autre sortie) — c'est ce qui masquait la mort d'un
# étage aval (le tee gardait l'amont vivant → wait -n aveugle). Avec =exit, si une
# sortie casse (ydraw.fifo, ais.fifo ou n2k-mux principal), le tee sort, l'amont
# s'effondre et le n2k-mux principal reçoit EOF → il sort. (Quand la branche YDRAW
# est désactivée, $YDRAW_TEE=cat, qui meurt déjà sur SIGPIPE — pas de souci.)
# $! = n2k-mux principal (dernier élément AVANT la redirection > OUTFIFO).
"$ACTISENSE" -s "$BAUD" "$DEVICE" < "$TXFIFO" \
  | $YDRAW_TEE \
  | "$ANALYZER" -json -nv \
  | tee --output-error=exit "$AISFIFO" \
  | "$N2KMUX" "$CONF" --tx "$TXFIFO" \
        --sources "$RUN/sources.json" --stats "$RUN/stats.json" \
        --busmap "$RUN/busmap.json" --sources-interval 2 \
  > "$OUTFIFO" &
PIDS+=($!)

# Surveillance : wait -n sur les PID EXACTS (ydraw-bridge si actif, n2kd, kplex,
# n2k-mux principal) — pas sur les jobs entiers. L'ancien `wait -n` nu attendait
# un job pipeline complet, qui n'est « terminé » que quand TOUS ses membres sont
# morts ; or le tee survivait à la mort d'un étage aval → wait -n ne rendait
# jamais la main (dégradation invisible). Dès qu'UN des PID suivis meurt, on sort
# → systemd relance l'unité entière, KillMode=control-group nettoie le reste.
wait -n "${PIDS[@]}"
exit 1
