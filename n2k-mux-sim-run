#!/bin/bash
# n2k-mux-sim-run — chaîne de production alimentée par le SIMULATEUR.
#
# Même aval que les chaînes réelles (arbitrage, AIS, kplex, UI web), mais la
# source n'est plus le bus : c'est n2k-sim, piloté à chaud par un fichier de
# contrôle que l'interface web écrit (onglet Simulateur).
#
#   n2k-sim --control $SIMCTL --state $RUN/sim.state --actisense-out n2k.fifo
#     ├→ n2k.fifo → ydraw-bridge (N2K YDRAW → TCP 2700, qtVlm en N2K)  [si installé]
#     └→ tee ais.fifo ─┬→ n2k-mux conf (instruments) → out0183.fifo → kplex (10110)
#                      └→ n2k-mux --ais-json conf → n2kd (AIS → 2599)
#
# Les deux sorties, JSON pour le 0183 et trames N2K pour le port 2700, viennent
# du MÊME processus simulateur : un seul état bateau, donc les mêmes valeurs des
# deux côtés. Deux simulateurs séparés auraient chacun leur vent aléatoire.
#
# Pas d'actisense ni d'analyzer : le simulateur émet déjà le JSON de l'analyzer.
# Pas d'ISO Request non plus : il annonce ses identités spontanément.
#
# Variables (Environment / EnvironmentFile du service) :
#   SIMCONF KPLEX_CONF SIMCTL N2KSIM N2KMUX N2KD KPLEX
#
# SIMCONF, et NON CONF : la configuration de production ne connaît que les
# appareils réels du bord. Les appareils simulés (SCX20-SIM, MAD-SIM…) y étaient
# rejetés comme « non configurés » et la chaîne ne sortait AUCUNE phrase
# d'instrument sur 10110, seulement l'AIS. SIMCONF pointe sur la config
# compagnon du simulateur (n2k-sim.ini), qui nomme ces identités. Variable
# distincte parce que /etc/default/n2k-mux définit souvent CONF.
#
# Le simulateur lit ses RÉGLAGES dans $SIMCTL (persistant, /etc) et republie
# l'état DÉDUIT dans $RUN/sim.state (éphémère) : route et vitesse fond, les trois
# expressions du vent, la position. L'interface web lit les deux.

set -uo pipefail

: "${SIMCONF:?}" "${KPLEX_CONF:?}"
: "${N2KSIM:?}" "${N2KMUX:?}" "${N2KD:?}" "${KPLEX:?}"
SIMCTL="${SIMCTL:-/etc/n2k-mux/sim.ctl}"

RUN="${RUNTIME_DIRECTORY:-/run/n2k-mux}"
SIMSTATE="$RUN/sim.state"    # état DÉDUIT publié par le simulateur (UI web)
AISFIFO="$RUN/ais.fifo"      # copie du flux simulé → branche AIS
OUTFIFO="$RUN/out0183.fifo"  # 0183 du n2k-mux principal → kplex
mkfifo -m 0600 "$AISFIFO" "$OUTFIFO" 2>/dev/null || true

# Pas de création du fichier de pilotage ici : l'unité protège /etc en lecture
# seule (ProtectSystem=full). Absent, le simulateur tourne en automatique ;
# l'interface web le crée au premier enregistrement.

# On suit les PID des composants CRITIQUES (cf. surveillance en fin de script).
PIDS=()

# Branche N2K réseau (YDRAW, port 2700) : même rôle que n2k-filter dans la chaîne
# socketcan, pour que qtVlm garde sa source N2K quand on bascule sur le
# simulateur. Active si ydraw-bridge est installé. Lancé AVANT le simulateur :
# l'ouverture du FIFO en lecture attend l'écrivain, et réciproquement.
YDRAW="${YDRAW:-/usr/local/bin/ydraw-bridge}"
YDRAW_PORT="${YDRAW_PORT:-2700}"
N2KFIFO="$RUN/n2k.fifo"
ACT_OPT=()
if [ -x "$YDRAW" ]; then
  mkfifo -m 0600 "$N2KFIFO" 2>/dev/null || true
  "$YDRAW" --port "$YDRAW_PORT" < "$N2KFIFO" &
  PIDS+=($!)
  ACT_OPT=(--actisense-out "$N2KFIFO")
fi

# Branche AIS : flux dupliqué → dédup MMSI → n2kd (VDM sur TCP 2599).
"$N2KMUX" --ais-json "$SIMCONF" < "$AISFIFO" | "$N2KD" &
PIDS+=($!)

# kplex lit le 0183 du n2k-mux principal via OUTFIFO (jobs distincts, PID suivis).
"$KPLEX" -f "$KPLEX_CONF" < "$OUTFIFO" &
PIDS+=($!)

# Branche principale. tee --output-error=exit : si une sortie casse (ais.fifo ou
# n2k-mux principal), le tee MEURT au lieu de masquer la panne (cf. n2k-mux-run).
# $! = n2k-mux principal (dernier élément AVANT la redirection > OUTFIFO).
"$N2KSIM" --control "$SIMCTL" --state "$SIMSTATE" "${ACT_OPT[@]}" \
  | tee --output-error=exit "$AISFIFO" \
  | "$N2KMUX" "$SIMCONF" \
        --sources "$RUN/sources.json" --stats "$RUN/stats.json" \
        --busmap "$RUN/busmap.json" --sources-interval 2 \
  > "$OUTFIFO" &
PIDS+=($!)

# Surveillance par PID EXACTS (ydraw-bridge si actif, n2kd, kplex, n2k-mux
# principal) : dès qu'UN meurt,
# on sort → systemd relance toute l'unité (KillMode=control-group nettoie).
# La mort du simulateur lui-même arrive en EOF au tee puis au n2k-mux principal.
wait -n "${PIDS[@]}"
exit 1
